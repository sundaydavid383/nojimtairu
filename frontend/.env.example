# Environment Variables Template
VITE_APP_NAME="Nojim Tairu & Co. — Property & Payment Records"
VITE_API_BASE_URL="/api"
VITE_ENABLE_PAYPAL_DEMO="true"
VITE_ENABLE_FORECASTING="false"
VITE_DEFAULT_THEME="light"
VITE_FIRM_NAME="Nojim Tairu & Co."
VITE_FIRM_EMAIL="info@ntlaw.ng"
VITE_FIRM_PHONE="+234 803 555 0192"

# ImageKit (property photos, receipt uploads)
# Get these from your ImageKit dashboard after signing up at https://imagekit.io
VITE_IMAGEKIT_PUBLIC_KEY="YOUR_IMAGEKIT_PUBLIC_KEY"
VITE_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/YOUR_IMAGEKIT_ID"
VITE_IMAGEKIT_AUTH_ENDPOINT="/api/imagekit/auth"  # Backend endpoint for signed upload tokens (server-side only)

# Note: The ImageKit private key must NEVER be exposed in the frontend.
# The backend must provide a /api/imagekit/auth endpoint that returns signed tokens.
# You will need to build that backend route before uploads will work.
