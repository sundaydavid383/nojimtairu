PORT=5000
MONGODB_URI=mongodb://localhost:27017/ntc_property_records
JWT_SECRET=nojimtairu_super_secret_jwt_key_2024_change_in_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Brevo (formerly Sendinblue) Transactional Email
# Sign up at https://www.brevo.com and get your API key from Settings > SMTP & API
# NEVER expose this key in frontend code — it must stay server-side only.
BREVO_API_KEY=YOUR_BREVO_API_KEY
BREVO_SENDER_EMAIL=noreply@ntlaw.ng
BREVO_SENDER_NAME="Nojim Tairu & Co."

# ImageKit Private Key (server-side only — used to sign upload tokens)
# Get this from your ImageKit dashboard > Developer > Private Key
IMAGEKIT_PRIVATE_KEY=YOUR_IMAGEKIT_PRIVATE_KEY
IMAGEKIT_PUBLIC_KEY=YOUR_IMAGEKIT_PUBLIC_KEY
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_IMAGEKIT_ID
MONGO_USER=username_placeholder_change_in_production
MONGO_PASSWORD=this_is_a_placeholder_password_change_in_production